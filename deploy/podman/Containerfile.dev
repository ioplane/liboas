# liboas development image
# Thin layer on top of the shared ioplane-base image.
#
# Build base first:
#   podman build -t ioplane-base:latest \
#     -f /opt/projects/repositories/container-images/tools/ioplane-base/Containerfile .
#
# Build this image:
#   podman build -t liboas-dev:latest -f deploy/podman/Containerfile.dev .

FROM localhost/ioplane-base:latest

LABEL maintainer="liboas development team"
LABEL description="Development environment for liboas — C23 OpenAPI 3.2 library"

# ═══════════════════════════════════════════════════════
# Project-specific dependencies
# ═══════════════════════════════════════════════════════

ARG YYJSON_VERSION=0.12.0
ARG LIBFYAML_VERSION=0.9

# yyjson (JSON parsing)
RUN cd /tmp && \
    wget "https://github.com/ibireme/yyjson/archive/refs/tags/${YYJSON_VERSION}.tar.gz" && \
    tar xzf "${YYJSON_VERSION}.tar.gz" && \
    cd "yyjson-${YYJSON_VERSION}" && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf yyjson-*

# libfyaml (YAML 1.2 parsing)
RUN cd /tmp && \
    wget "https://github.com/pantoniou/libfyaml/releases/download/v${LIBFYAML_VERSION}/libfyaml-${LIBFYAML_VERSION}.tar.gz" && \
    tar xzf "libfyaml-${LIBFYAML_VERSION}.tar.gz" && \
    cd "libfyaml-${LIBFYAML_VERSION}" && \
    ./configure --prefix=/usr/local && \
    make -j"$(nproc)" && \
    make install && \
    ldconfig && \
    cd /tmp && rm -rf libfyaml-*

RUN ldconfig

WORKDIR /workspace
CMD ["/bin/bash"]
